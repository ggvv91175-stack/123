# ===== 应用 =====
APP_PORT=8080
# 允许的前端来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173

# ===== 数据库 =====
# 数据库类型：sqlite（本地开发默认）| mysql（Docker 编排 / 生产）
DB_TYPE=sqlite

# ----- SQLite（DB_TYPE=sqlite 时生效）-----
# 数据库文件路径（相对 server 工作目录或绝对路径）
DB_FILE=./data/campus_xianyu.db

# ----- MySQL（DB_TYPE=mysql 时生效）-----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=campus_xianyu

# ===== JWT =====
# 密钥必须 >= 256bit，且仅通过环境变量注入，禁止提交到代码仓库
JWT_SECRET=please-change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=2h

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
