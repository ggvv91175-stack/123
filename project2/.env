# ===== 必填：上线前务必修改 =====
# MySQL root 密码（server 容器与 mysql 容器共用）
MYSQL_ROOT_PASSWORD=root123456
# JWT 密钥：必须 >= 64 位随机字符串，禁止泄露
JWT_SECRET=please-change-me-to-a-long-random-string-at-least-64-chars
# 允许的前端来源（多个用逗号分隔）；本地一键启动用 http://localhost 即可
# 线上：填你的域名，如 https://xianyu.example.com
CORS_ORIGIN=http://localhost

# ===== 可选 =====
# 前端对外端口（浏览器访问入口）
WEB_PORT=80
# MySQL 对外端口（仅调试用，生产建议不暴露或加防火墙）
MYSQL_PORT=3306
# JWT 过期时间
JWT_EXPIRES_IN=2h
